{
  "name": "backend-express-ts-mysql2",
  "version": "1.0.0",
  "description": "Backend Express + TS + CORS + MySQL2",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean --out-dir dist",
    "dev": "tsup src/index.ts --format esm --sourcemap --watch --onSuccess \"node dist/index.js\"",
    "watch": "tsc --noEmit -w --preserveWatchOutput",
    "start": "node dist/index.js",
    "start:dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "check": "tsc --noEmit",
    "food-images:dry-run": "tsx src/scripts/assignFoodImages.ts",
    "food-images:apply": "tsx src/scripts/assignFoodImages.ts --apply",
    "format": "prettier --write \"{src,tests}/**/*.{ts,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "firebase-admin": "^13.5.0",
    "joi": "^18.0.1",
    "multer": "^2.2.0",
    "mysql2": "^3.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.0",
    "tsup": "^8.1.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.3"
  }
}
